# ==============================================================================
# ALFACARE ANIMAL CLINIC JAKARTA - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in your actual credentials
# ==============================================================================

# 1. Supabase Project Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. Supabase Service Role Key (Backend Server-side Only - NEVER expose to browser)
# Found in Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# 3. Clinic Communication & Dispatch
NEXT_PUBLIC_CLINIC_WHATSAPP=6281188997700
NEXT_PUBLIC_CLINIC_PHONE=+622155550199
NEXT_PUBLIC_CLINIC_EMAIL=care@alfacare.co.id

# 4. Optional: Resend API Key for Transactional Booking Email Confirmations
RESEND_API_KEY=
